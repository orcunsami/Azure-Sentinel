{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 1,
      "content": {
        "json": "## SOCRadar Threat Feeds Dashboard\nThreat intelligence indicator analytics from SOCRadar feeds."
      },
      "name": "header"
    },
    {
      "type": 1,
      "content": {
        "json": "---\n### Overview"
      },
      "name": "overview-header"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "SOCRadar_Feeds_CL\n| summarize Count=dcount(IndicatorValue)\n| project Count",
        "size": 4,
        "title": "Total Indicators",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "tiles",
        "tileSettings": {
          "titleContent": {
            "columnMatch": "Count",
            "formatter": 12,
            "formatOptions": {
              "palette": "auto"
            }
          },
          "showBorder": false
        }
      },
      "customWidth": "25",
      "name": "total-indicators"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "SOCRadar_Feeds_CL\n| summarize Count=dcount(CollectionName)\n| project Count",
        "size": 4,
        "title": "Active Collections",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "tiles",
        "tileSettings": {
          "titleContent": {
            "columnMatch": "Count",
            "formatter": 12,
            "formatOptions": {
              "palette": "auto"
            }
          },
          "showBorder": false
        }
      },
      "customWidth": "25",
      "name": "active-collections"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "SOCRadar_Feeds_CL\n| summarize Count=dcount(IndicatorType)\n| project Count",
        "size": 4,
        "title": "Indicator Types",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "tiles",
        "tileSettings": {
          "titleContent": {
            "columnMatch": "Count",
            "formatter": 12,
            "formatOptions": {
              "palette": "auto"
            }
          },
          "showBorder": false
        }
      },
      "customWidth": "25",
      "name": "indicator-types"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "SOCRadar_Feeds_CL\n| where TimeGenerated > ago(24h)\n| summarize Count=dcount(IndicatorValue)\n| project Count",
        "size": 4,
        "title": "Last 24 Hours",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "tiles",
        "tileSettings": {
          "titleContent": {
            "columnMatch": "Count",
            "formatter": 12,
            "formatOptions": {
              "palette": "auto"
            }
          },
          "showBorder": false
        }
      },
      "customWidth": "25",
      "name": "last-24h"
    },
    {
      "type": 1,
      "content": {
        "json": "---\n### Indicator Analysis"
      },
      "name": "analysis-header"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "SOCRadar_Feeds_CL\n| summarize Count=dcount(IndicatorValue) by IndicatorType\n| order by Count desc",
        "size": 2,
        "title": "Indicators by Type",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "piechart"
      },
      "customWidth": "50",
      "name": "indicators-by-type"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "SOCRadar_Feeds_CL\n| summarize Count=dcount(IndicatorValue) by CollectionName\n| order by Count desc",
        "size": 2,
        "title": "Indicators by Collection",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "barchart"
      },
      "customWidth": "50",
      "name": "indicators-by-collection"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "SOCRadar_Feeds_CL\n| summarize Count=count() by bin(TimeGenerated, 1h)\n| order by TimeGenerated asc",
        "size": 0,
        "title": "Indicators Over Time",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "timechart"
      },
      "name": "indicators-timeline"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "SOCRadar_Feeds_CL\n| summarize Count=dcount(IndicatorValue) by CollectionName\n| top 10 by Count desc",
        "size": 2,
        "title": "Top 10 Collections",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "barchart"
      },
      "name": "top-collections"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "SOCRadar_Feeds_CL\n| project TimeGenerated, CollectionName, IndicatorType, IndicatorValue, Source\n| order by TimeGenerated desc\n| take 50",
        "size": 0,
        "title": "Recent Indicators",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "table"
      },
      "name": "recent-indicators"
    },
    {
      "type": 1,
      "content": {
        "json": "---\n### Audit Monitoring"
      },
      "name": "audit-header"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "SOCRadar_Feeds_Audit_CL\n| summarize Count=count() by Status\n| order by Count desc",
        "size": 2,
        "title": "Import Run Status",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "piechart"
      },
      "customWidth": "50",
      "name": "audit-status"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "SOCRadar_Feeds_Audit_CL\n| summarize Created=sum(IndicatorsCreated), Skipped=sum(IndicatorsSkipped) by bin(TimeGenerated, 1h)\n| order by TimeGenerated asc",
        "size": 0,
        "title": "Indicators Created vs Skipped",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "timechart"
      },
      "customWidth": "50",
      "name": "created-vs-skipped"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "SOCRadar_Feeds_Audit_CL\n| project TimeGenerated, Status, CollectionsProcessed, IndicatorsCreated, IndicatorsSkipped, CollectionsFailed, IndicatorsFailed, DurationMs, ErrorMessage\n| order by TimeGenerated desc\n| take 20",
        "size": 0,
        "title": "Recent Import Runs",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "visualization": "table"
      },
      "name": "recent-runs"
    }
  ],
  "isLocked": false,
  "fallbackResourceIds": [
    "/subscriptions/{Subscription}/resourceGroups/{ResourceGroup}/providers/Microsoft.OperationalInsights/workspaces/{Workspace}"
  ]
}